# Copy this to .env — never commit .env to GitHub

SECRET_KEY=your-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-app.railway.app,localhost,127.0.0.1

# Railway gives this automatically when you add PostgreSQL plugin
DATABASE_URL=postgresql://user:password@host:port/dbname

# Your Vercel frontend URL (no trailing slash)
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
